\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Late-time Cauchy slice $\Sigma _t$ of an evaporating black hole formed by a collapsing shell (zoomed on the relevant region; null lines at $45^\circ $). Outside the horizon the slice carries the outgoing Hawking modes $r$, which are the same system $R$ in both descriptions. Inside, it carries the infalling partner modes $\ell $ near the horizon and, at its inner end, the collapsed matter $f$, frozen in the state it fell in with. In the fundamental description the whole interior segment is encoded in the black hole's microstates $B$ at the horizon crossing, with $\qopname  \relax o{dim}\mathcal  H_B=e^{A/4G}$: the map $V$ squeezes a segment onto a point whose size is its area. Lower-case labels are what a semiclassical observer assigns to a region; upper-case labels are the fundamental Hilbert spaces. They differ only at the horizon, and the difference is $V$.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:penrose}{{2}{5}{Late-time Cauchy slice $\Sigma _t$ of an evaporating black hole formed by a collapsing shell (zoomed on the relevant region; null lines at $45^\circ $). Outside the horizon the slice carries the outgoing Hawking modes $r$, which are the same system $R$ in both descriptions. Inside, it carries the infalling partner modes $\ell $ near the horizon and, at its inner end, the collapsed matter $f$, frozen in the state it fell in with. In the fundamental description the whole interior segment is encoded in the black hole's microstates $B$ at the horizon crossing, with $\dim \Hil _B=e^{A/4G}$: the map $V$ squeezes a segment onto a point whose size is its area. Lower-case labels are what a semiclassical observer assigns to a region; upper-case labels are the fundamental Hilbert spaces. They differ only at the horizon, and the difference is $V$}{figure.2}{}}
\newlabel{fig:penrose@cref}{{[figure][2][]2}{[1][4][]5}}
\newlabel{eq:reduced}{{2}{5}{The black hole interior}{equation.2.2}{}}
\newlabel{eq:reduced@cref}{{[equation][2][]2}{[1][5][]5}}
